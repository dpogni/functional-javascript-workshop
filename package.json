{
  "name": "react-interview-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "React live-coding interview workshop with automated pass/fail grading, in the terminal or the browser.",
  "type": "module",
  "scripts": {
    "progress": "node scripts/cli.js progress",
    "check": "node scripts/cli.js check",
    "watch": "node scripts/cli.js watch",
